# Rule-Based Expert System

# Knowledge Base (Propositional Logic)
rules = {
    "Fever and Cough": "Flu",
    "Fever and Headache": "Infection",
    "Sneezing and Cough": "Cold"
}

# Forward Chaining
def forward_chaining(facts):
    print("\nForward Chaining:")
    new_facts = facts.copy()

    for condition, result in rules.items():
        symptoms = condition.split(" and ")

        if all(s in new_facts for s in symptoms):
            new_facts.add(result)
            print("Rule Applied:", condition, "->", result)

    print("Final Facts:", new_facts)


# Backward Chaining
def backward_chaining(goal, facts):
    print("\nBackward Chaining:")
    
    if goal in facts:
        return True

    for condition, result in rules.items():
        if result == goal:
            symptoms = condition.split(" and ")

            if all(s in facts for s in symptoms):
                print("Goal Proved:", goal)
                return True

    return False


# User Input
facts = set(input(
    "Enter symptoms separated by comma "
    "(Fever, Cough, Headache, Sneezing): "
).title().replace(" ", "").split(","))

# Forward Chaining
forward_chaining(facts)

# Backward Chaining
goal = input("\nEnter goal to check (Flu, Infection, Cold): ").title()

if backward_chaining(goal, facts):
    print(goal, "is identified.")
else:
    print(goal, "cannot be identified.")

